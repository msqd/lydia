    "release-notes": "node scripts/release-notes.mjs",
    "check": "biome check src --write && pnpm types",
    "check-ci": "biome ci src",
    "dev": "storybook dev -p 6006 --no-open --host localhost",
    "format": "biome format src --write",
    "lint": "biome lint src --write",
    "storybook": "storybook build",
