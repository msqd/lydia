    "build": "rm -rf dist && tsc -p tsconfig.build.json && vite build -l silent && rm -rf dist/node_modules dist/_virtual && node scripts/copy-css-sources.mjs && node scripts/relativize-declaration-imports.mjs && node scripts/generate-exports.mjs",
    "build:verbose": "rm -rf dist && tsc -p tsconfig.build.json && vite build -l info && rm -rf dist/node_modules dist/_virtual && node scripts/copy-css-sources.mjs && node scripts/relativize-declaration-imports.mjs && node scripts/generate-exports.mjs",
