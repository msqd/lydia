    "test:storybook": "vitest run --project storybook",
    "test:storybook:update": "vitest run --project storybook -u",
    "test:storybook:watch": "vitest --project storybook",
    "test:update": "vitest run --project unit -u",
    "test:watch": "vitest --project unit",
    "types": "tsc -p tsconfig.build.json && tsc -p tsconfig.types.json"
