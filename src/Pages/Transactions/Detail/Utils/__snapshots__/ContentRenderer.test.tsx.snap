exports[`ContentRenderer > code > renders a JSON document 1`] = `
<div>
  <div
    class="border border-gray-200 rounded-md overflow-hidden bg-white"
  >
    <div
      class="relative"
    >
      <div
        aria-label="Code"
        class="overflow-auto p-3"
        role="group"
        style="height: 400px;"
        tabindex="0"
      >
        <div>
          <div>
            <div
              class="font-mono text-xs leading-5 whitespace-pre"
              style="height: 20px;"
            >
              <span
                class="token punctuation"
              >
                {
              </span>
            </div>
            <div
              class="font-mono text-xs leading-5 whitespace-pre"
              style="height: 20px;"
            >
                
              <span
                class="token property"
              >
                "a"
              </span>
              <span
                class="token operator"
              >
                :
              </span>
               
              <span
                class="token number"
              >
                1
              </span>
            </div>
            <div
              class="font-mono text-xs leading-5 whitespace-pre"
              style="height: 20px;"
            >
              <span
                class="token punctuation"
              >
                }
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
`;

