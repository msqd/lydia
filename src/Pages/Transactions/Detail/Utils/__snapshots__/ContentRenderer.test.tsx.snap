exports[`ContentRenderer > PDF > previews a PDF data URL in a frame that sends no referrer 1`] = `
<div>
  <div
    class="space-y-4"
  >
    <div
      class="bg-gray-50 rounded-md p-4"
    >
      <iframe
        class="w-full h-96 border border-gray-300 rounded"
        referrerpolicy="no-referrer"
        src="data:application/pdf;base64,JVBERi0="
        title="PDF Preview"
      />
    </div>
    <div
      class="flex justify-center"
    >
      <div
        class="inline-flex flex-col items-center gap-1"
      >
        <button
          class="font-semibold cursor-pointer shadow-xs text-white bg-primary-500 hover:bg-primary-400 focus-visible:outline-primary-500 focus-visible:outline-2 focus-visible:outline-offset-2 ring-1 ring-inset ring-primary-600 disabled:ring-gray-300 disabled:bg-gray-200 disabled:text-gray-400 disabled:cursor-not-allowed active:bg-primary-600 active:ring-primary-700 rounded-sm px-2 py-1 text-sm flex items-center gap-2"
          type="button"
