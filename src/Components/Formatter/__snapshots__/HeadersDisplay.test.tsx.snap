// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`HeadersDisplay > matches snapshot 1`] = `
<div
  class="font-mono text-xs"
>
  <div
    class="flex"
  >
    <span
      class="text-gray-600 mr-2"
    >
      Content-Type
      :
    </span>
    <span
      class="text-gray-900 break-all"
    >
      application/json
    </span>
  </div>
  <div
    class="flex"
  >
    <span
      class="text-gray-600 mr-2"
    >
      Authorization
      :
    </span>
    <span
      class="text-gray-900 break-all"
    >
      Bearer token123
    </span>
  </div>
</div>
`;

exports[`HeadersDisplay > matches snapshot with empty headers 1`] = `
<div
  class="text-gray-500 text-xs italic"
>
  No headers
</div>
`;

exports[`HeadersDisplay > matches snapshot with repeated headers 1`] = `
<div
  class="font-mono text-xs"
>
  <div
    class="flex"
  >
    <span
      class="text-gray-600 mr-2"
    >
      set-cookie
      :
    </span>
    <span
      class="text-gray-900 break-all"
    >
      session=abc
    </span>
  </div>
  <div
    class="flex"
  >
    <span
      class="text-gray-600 mr-2"
    >
      set-cookie
      :
    </span>
    <span
      class="text-gray-900 break-all"
    >
      theme=dark
    </span>
  </div>
</div>
`;
